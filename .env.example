# Copy to .env and fill in. Never commit .env (it is git-ignored).
# Run a service with these variables: uv run --env-file .env t2-gateway

# --- Task 2: MCP security gateway ---
# Required. HS256 secret of at least 32 bytes, for example: openssl rand -hex 32
GATEWAY_JWT_SECRET=
GATEWAY_JWT_AUDIENCE=mcp-gateway
# Optional. When set, tokens must carry this iss claim.
GATEWAY_JWT_ISSUER=
GATEWAY_DOWNSTREAM_URL=http://127.0.0.1:8001/mcp
# Comma-separated browser origins allowed to call the gateway. Empty rejects any Origin header.
GATEWAY_ALLOWED_ORIGINS=
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8000

# --- Task 4: model router (rate limiter + failover) ---
# SQLite file with tenants, API key digests and token usage. Create tenants with: uv run t4-tenants add acme
T4_DB_PATH=t4-router.db
T4_PRIMARY_URL=http://127.0.0.1:9201/v1/chat/completions
# Optional. Sent to the provider as a bearer token; never the tenant's key.
T4_PRIMARY_API_KEY=
# Optional. Model name to send to this provider instead of the client's.
T4_PRIMARY_MODEL=
# Total deadline for the primary's whole response, in milliseconds.
T4_PRIMARY_DEADLINE_MS=3000
# Empty to disable failover.
T4_SECONDARY_URL=http://127.0.0.1:9202/v1/chat/completions
T4_SECONDARY_API_KEY=
T4_SECONDARY_MODEL=
T4_SECONDARY_DEADLINE_MS=15000
T4_DEFAULT_MAX_TOKENS=1024
T4_MAX_OUTPUT_TOKENS=4096
T4_MAX_BODY_BYTES=1048576
T4_HOST=127.0.0.1
T4_PORT=8300
